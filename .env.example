# ==========================================================
# CONFIGURAÇÕES DO ELO VET - MICROSSERVIÇO DE IA CLÍNICA (FASTAPI)
# Copie este arquivo para .env e preencha com seus valores.
# ==========================================================

# Chave do Google Gemini (https://aistudio.google.com/apikey).
# Mantida como MOCK_KEY, o serviço roda em modo simulado.
GEMINI_API_KEY=MOCK_KEY
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=30000

# Rede do servidor (0.0.0.0 permite conexões externas e uso em Docker)
HOST=0.0.0.0
PORT=8000
