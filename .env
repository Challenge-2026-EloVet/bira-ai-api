# 1. Chave de API do Google Gemini (Crucial para o diagnóstico e estruturação SOAP)
# Substitua pelo seu token real gerado na plataforma do Google AI Studio (https://aistudio.google.com/apikey)
# Se não for configurada ou mantida como "MOCK_KEY", o serviço rodará em modo simulado.
GEMINI_API_KEY=AQ.Ab8RN6KjrPpmp4h1GFwqR1OrRyO_1EGJaUeNabvBISH2OStLvA

# 2. Configurações de Rede do Servidor (Uvicorn)
# HOST 0.0.0.0 é fundamental para permitir conexões externas e funcionar dentro do Docker.
HOST=0.0.0.0
PORT=8000

# 3. Configurações de Ambiente
APP_ENV=development
LOG_LEVEL=info